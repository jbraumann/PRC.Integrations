/* Clear the Table: white studio cards over the scene. Sizes are for a 1920x1080 reference. */

.layer, .hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud {
    padding: 28px;
    justify-content: space-between;
}

.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; }
.top-row { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.bottom-row { flex-direction: row; justify-content: center; }

.card {
    background-color: rgba(255, 255, 255, 0.92);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(16, 24, 40, 0.08);
    padding: 18px 22px;
    color: rgb(24, 30, 44);
}

.badge {
    background-color: rgb(255, 107, 44);
    color: white;
    -unity-font-style: bold;
    font-size: 15px;
    padding: 4px 9px;
    border-radius: 7px;
    margin-right: 12px;
}

.title { font-size: 28px; -unity-font-style: bold; }
.robot-row { margin-top: 14px; margin-bottom: 10px; }
.robot-names { width: 340px; margin: 0 12px; }
.robot-name { font-size: 20px; -unity-font-style: bold; white-space: normal; }
.meta { font-size: 14px; color: rgb(98, 108, 126); white-space: normal; }
.caption { font-size: 12px; letter-spacing: 1.5px; color: rgb(120, 128, 146); -unity-font-style: bold; }

.score { align-items: flex-end; min-width: 220px; }
.score-value { font-size: 44px; -unity-font-style: bold; margin: 2px 0 6px 0; }
.stars { margin-bottom: 8px; }
.star {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-left: 6px;
    background-color: rgb(222, 227, 234);
}
.star.on { background-color: rgb(255, 176, 32); }

.banner {
    position: absolute;
    top: 40px;
    left: 50%;
    translate: -50% 0;
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(24, 30, 44);
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: 18px;
    padding: 14px 28px;
}

.dock { padding: 14px 16px 12px 22px; }
.plan { width: 240px; margin-right: 8px; }
.pins { font-size: 20px; -unity-font-style: bold; }
.warning { color: rgb(226, 54, 60); }
.status { font-size: 14px; color: rgb(98, 108, 126); margin-top: 10px; white-space: normal; max-width: 980px; }
.status.warning { color: rgb(226, 54, 60); }

.button {
    background-color: rgb(236, 239, 244);
    border-width: 0;
    border-radius: 12px;
    padding: 12px 18px;
    margin: 0 0 0 8px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(24, 30, 44);
}
.button:hover { background-color: rgb(224, 229, 237); }
.button:active { background-color: rgb(210, 217, 228); }
.button:disabled { opacity: 0.4; }
.primary { background-color: rgb(255, 107, 44); color: white; min-width: 110px; }
.primary:hover { background-color: rgb(255, 128, 72); }
.primary:active { background-color: rgb(235, 92, 30); }
.round {
    width: 40px;
    height: 40px;
    padding: 0;
    margin: 0;
    border-radius: 20px;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.drawer {
    position: absolute;
    right: 28px;
    top: 200px;
    bottom: 160px;
    width: 560px;
}
.drawer-head { align-items: flex-start; margin-bottom: 10px; }
.program-name { font-size: 18px; -unity-font-style: bold; }
.code-scroll {
    flex-grow: 1;
    background-color: rgb(246, 247, 250);
    border-radius: 10px;
    padding: 10px 12px;
}
.code { font-size: 14px; color: rgb(38, 46, 64); white-space: nowrap; }
.drawer-buttons { margin-top: 12px; justify-content: flex-end; }

.pin-label {
    position: absolute;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(31, 115, 242);
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: white;
}
.pin-label.alarm { background-color: rgb(226, 54, 60); }

.error {
    position: absolute;
    left: 50%;
    top: 40%;
    translate: -50% -50%;
    width: 620px;
    align-items: center;
    padding: 28px;
}
.error-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 8px; }
.error-detail { -unity-text-align: middle-center; margin-bottom: 18px; }
